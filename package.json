{
  "name": "@someok/ai-quota",
  "version": "1.0.0",
  "description": "在终端统一查看多个 AI 服务账号的额度、余额和用量",
  "type": "module",
  "bin": {
    "ai-quota": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:terminal": "pnpm build && node scripts/run-terminal-tests.mjs",
    "test:live": "pnpm build && node scripts/live-check.mjs",
    "test:watch": "vitest",
    "security": "node scripts/security-check.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm security",
    "prepublishOnly": "pnpm check"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "jsonc-parser": "^3.3.1",
    "picocolors": "^1.1.1",
    "undici": "^7.29.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
